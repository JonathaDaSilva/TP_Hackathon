# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha
# os valores reais. O "docker compose" carrega esse ".env" automaticamente.
# Sem esse arquivo, a aplicação sobe normalmente com os valores padrão de
# desenvolvimento (inclusive com envio de e-mail desativado).

# --- Autenticação ---
# Chave usada para assinar os tokens JWT. Gere uma string aleatória de pelo
# menos 32 caracteres antes de ir para produção.
JWT_SECRET=dev-only-super-secret-key-troque-em-producao-32chars+
JWT_EXPIRATION_MINUTES=60

# --- E-mail (formulário "Fale Conosco") ---
# Sem SMTP_USER/SMTP_PASSWORD preenchidos, o envio de e-mail é pulado
# automaticamente (a mensagem ainda é salva no banco, só não é enviada).
#
# Opção rápida para testar (Mailtrap Sandbox, gratuito, não entrega e-mail
# real, só captura para você visualizar): crie uma conta em mailtrap.io,
# abra uma "Inbox" e copie host/porta/usuário/senha da aba SMTP Settings.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Endereço que aparece como remetente e o e-mail da equipe que recebe as
# mensagens do formulário de contato.
MAIL_FROM=no-reply@avicola.local
MAIL_DESTINATARIO=equipe@avicola.local
